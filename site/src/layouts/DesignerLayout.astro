---
import '../styles/site.css';
import ThemeBoot from '../components/theme/ThemeBoot.astro';
import ThemeSelectInline from '../components/theme/ThemeSelectInline.astro';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'Designer',
	description = 'Build and export EvoGym world JSON in the browser.',
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<meta name="description" content={description} />
		<link rel="icon" href={`${base}/favicon.svg`} />
		<title>{`${title} | JAX EvoGym`}</title>
		<ThemeBoot />
	</head>
	<body class="min-h-[100dvh] overflow-hidden bg-app font-sans text-ink antialiased">
		<div class="flex h-[100dvh] min-h-[100dvh] min-h-0 flex-col overflow-hidden">
			<header class="designer-header z-30 shrink-0 border-b border-border/80 bg-panel/95 backdrop-blur-sm">
				<div class="flex items-center justify-between gap-2 px-3 py-1 sm:py-3 md:px-6">
					<a href={`${base}/`} class="flex shrink-0 items-center gap-3 no-underline">
						<span class="hidden size-11 items-center sm:flex justify-center rounded-2xl bg-accent font-mono text-sm font-semibold text-on-accent">
							JX
						</span>
						<span class="min-w-0">
							<span class="block text-sm font-semibold text-balance text-ink">JAX EvoGym</span>
							<span class="hidden text-sm text-muted text-pretty sm:block">Docs + browser designer</span>
						</span>
					</a>
					<nav aria-label="Primary" class="designer-scroll flex min-w-0 max-w-full flex-nowrap items-center gap-2 overflow-x-auto text-sm">
						<a href={`${base}/getting-started/installation/`} class="rounded-full px-3 py-2 text-ink transition hover:bg-canvas">
							Docs
						</a>
						<a href={`${base}/designer/`} class="hidden sm:block rounded-full bg-accent px-3 py-2 text-on-accent transition hover:opacity-90">
							Designer
						</a>
						<ThemeSelectInline />
						<a
							href="https://github.com/btgaskin/jax-evogym"
							target="_blank"
							rel="noreferrer"
							class="hidden sm:block rounded-full border border-border bg-surface px-3 py-2 text-ink transition hover:border-accent hover:text-accent"
						>
							GitHub
						</a>
					</nav>
				</div>
			</header>
			<main class="min-h-0 flex-1 overflow-hidden">
				<slot />
			</main>
		</div>
	</body>
</html>
